# previewd.service: the previewd agent (docs/deployment.md).
#
# Installed by the deb/rpm packages (nfpm.yaml) to
# /usr/lib/systemd/system/previewd.service. Site settings go in
# /etc/previewd/previewd.conf (PREVIEWD_* keys, docs/configuration.md):
# paths and identifiers only, never a secret value.
#
# Before the first start (each one is checked at start, and a missing one
# refuses the start):
#   - seal the credentials below with systemd-creds (docs/configuration.md,
#     Credentials); add the TLS key credential when PREVIEWD_TLS_KEY_CREDENTIAL
#     is set, it has no default name;
#   - mount the ramfs staging root: systemctl enable --now
#     run-previewd-secrets.mount (docs/deployment.md, section 4);
#   - load Traefik and the allowed base images, start Traefik: systemctl
#     enable --now previewd-proxy.service (docs/deployment.md, section 3);
#   - run `previewd doctor` and fix what it reports.
#
# Group=docker gives the daemon the Engine API socket, which is root on this
# host: keep the docker group to previewd and the administrators.

[Unit]
Description=previewd preview environment agent
After=network.target docker.service previewd-proxy.service
Requires=docker.service
# Ordering only: the proxy is verified at every start, but starting it stays
# the site's choice (previewd-proxy.service, or docker compose on a host that
# already runs Traefik that way: two proxies would fight for the name, the
# address and port 80).
# run-previewd-secrets.mount, pulled in and ordered before this unit. A site
# that moves PREVIEWD_SECRETS_STAGING_DIR overrides this line and the chown
# below in a drop-in.
RequiresMountsFor=/run/previewd/secrets

[Service]
Type=simple
User=previewd
Group=docker
# State (SQLite: environments, jobs, audit trail) and the default
# PREVIEWD_ROUTES_DIR, created owned by previewd. The conf file may override
# PREVIEWD_DB_PATH: EnvironmentFile= takes precedence over Environment=.
StateDirectory=previewd previewd/routes
StateDirectoryMode=0750
Environment=PREVIEWD_DB_PATH=/var/lib/previewd/previewd.sqlite
EnvironmentFile=-/etc/previewd/previewd.conf
# ramfs takes no uid= option: hand the staging root to the daemon's user
# (with privileges, "+"). A failure is ignored here and refused by the
# daemon, which checks the owner itself.
ExecStartPre=-+/usr/bin/chown previewd:previewd /run/previewd/secrets
ExecStart=/usr/bin/previewd
Restart=on-failure
RestartSec=5s

# The daemon locks all memory before reading any secret and refuses to start
# unless RLIMIT_MEMLOCK is unlimited.
LimitMEMLOCK=infinity
# No core file: a crash must not write the secrets held in memory to disk.
# The daemon also sets RLIMIT_CORE and the dumpable flag itself and refuses
# to start unless it can verify both.
LimitCORE=0

# Read by name from $CREDENTIALS_DIRECTORY, never from the environment.
LoadCredentialEncrypted=webhook_secret:/etc/credstore.encrypted/webhook_secret
LoadCredentialEncrypted=github-app-key:/etc/credstore.encrypted/github-app-key

# Kernel filter on the daemon's sockets and its git children, both ways:
# nothing but loopback until the site allows its GHES address, which both
# delivers the webhooks and serves the API and git. Add it with a drop-in
# (systemctl edit previewd), never by editing this file:
#   [Service]
#   IPAddressAllow=10.20.0.10/32
# The Engine API is a Unix socket and is unaffected. Needs cgroup v2.
# 172.30.255.2 is the proxy on previewd-proxy (docker-compose.yml,
# previewd-proxy.service): the daemon reads Traefik's request counters
# there (PREVIEWD_TRAEFIK_METRICS_ADDR, V1.2 ingress activity sensing).
IPAddressDeny=any
IPAddressAllow=localhost
IPAddressAllow=172.30.255.2/32

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes

[Install]
WantedBy=multi-user.target
