# run-previewd-secrets.mount: the secrets staging root, a ramfs mounted at
# boot (docs/deployment.md, section 4).
#
# Installed by the deb/rpm packages (nfpm.yaml) to
# /usr/lib/systemd/system/run-previewd-secrets.mount. The unit name is the
# escaped form of Where=: systemd refuses a mount unit named otherwise.
#
# ramfs, never tmpfs: its pages are not swappable, so a staged secret cannot
# reach the swap device. The price is that ramfs has no size limit; only the
# daemon, as the previewd user, can write here (mode 0700), and it writes one
# small file per secret section of a running environment. A reboot or a stop
# of this unit discards everything.
#
# ramfs takes no uid= or gid= option: the mount point is owned by root until
# previewd.service chowns it to the previewd user before each start
# (ExecStartPre=+, previewd.service). `previewd doctor` checks all of it.
#
# The daemon needs this mount (previewd.service: RequiresMountsFor=) and
# refuses to stage secrets anywhere that is not ramfs unless
# PREVIEWD_ALLOW_TMPFS_SECRETS=1. If the site moves PREVIEWD_SECRETS_STAGING_DIR,
# copy this unit under the escaped name of the new path.

[Unit]
Description=previewd secrets staging root (ramfs, never swapped)
Documentation=file:///usr/share/doc/previewd/deployment.md

[Mount]
What=ramfs
Where=/run/previewd/secrets
Type=ramfs
Options=mode=0700,nosuid,nodev,noexec
# The mount point systemd creates when missing.
DirectoryMode=0700

[Install]
WantedBy=local-fs.target
